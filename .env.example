# =============================================================================
#  Copy to .env  ->  cp .env.example .env  ->  fill in every value you use.
#  `docker compose` auto-loads .env. NEVER commit the real .env.
#  Generate strong secrets with:  openssl rand -hex 32
#
#  Sections map to the overlay files. You only need the variables for the
#  overlays you actually bring up. On-demand modules (SAP, Greenlight Guru) and
#  optional extras are clearly marked.
# =============================================================================

# -----------------------------------------------------------------------------
#  COMPOSE PROFILE — which overlay files form your stack (see docs §2)
#  With this set, a bare `docker compose up -d` brings up the standard set.
#  Append :docker-compose.erp.yml and/or :docker-compose.glg.yml when needed.
# -----------------------------------------------------------------------------
COMPOSE_FILE=docker-compose.yml:docker-compose.integration.yml:docker-compose.knowledgebase.yml:docker-compose.repo.yml:docker-compose.ticketing.yml:docker-compose.collab.yml:docker-compose.m365.yml:docker-compose.monitoring.yml

# -----------------------------------------------------------------------------
#  CORE / BASE  (docker-compose.yml)
# -----------------------------------------------------------------------------
# Single tree holding all persistent data (this is what Restic backs up):
DATA_ROOT=/opt/ai-stack/data

# --- Inference engine (vLLM) — configurable; defaults = SINGLE NODE, 1 GPU ---
# Model vLLM serves. DEFAULT = Llama-3.1-8B FP8 (native 128k ctx -> clean 64k
# for Hermes, no rope-scaling needed).
VLLM_MODEL=RedHatAI/Meta-Llama-3.1-8B-Instruct-FP8
VLLM_SERVED_NAME=llama3.1-8b
VLLM_MAX_MODEL_LEN=65536
VLLM_GPU_MEMORY_UTILIZATION=0.82
VLLM_KV_CACHE_DTYPE=fp8
VLLM_MAX_NUM_SEQS=8
# Extra raw flags appended to `vllm serve` (word-split). Used for Qwen YaRN,
# Ray backend, trust-remote-code, etc. Empty by default.
VLLM_EXTRA_ARGS=
# Hugging Face token — only needed if the chosen model/repo is gated:
HF_TOKEN=

#  --- ALTERNATIVE MODEL: Qwen (fully supported) ------------------------------
#  Qwen2.5/Qwen3 are excellent for agentic/multilingual use, but their NATIVE
#  context is 32k, so reaching Hermes's 64k needs YaRN rope-scaling. Recommended
#  fit for 20 GB + 64k: Qwen2.5-7B-Instruct-FP8 or Qwen3-8B (FP8). To switch,
#  set the four lines below (replace the defaults above):
#    VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-FP8
#    VLLM_SERVED_NAME=qwen
#    VLLM_MAX_MODEL_LEN=65536
#    VLLM_EXTRA_ARGS=--trust-remote-code --rope-scaling {"rope_type":"yarn","factor":2.0,"original_max_position_embeddings":32768}
#  (14B-class models do NOT fit 64k on 20 GB; keep to ~7-8B for this appliance.)

#  --- MULTI-NODE / MULTI-GPU (default single node) ---------------------------
#  Single host, N GPUs:   set TENSOR_PARALLEL_SIZE=N and GPU_COUNT=N (no Ray).
#  Multi-node (Ray):      TENSOR_PARALLEL_SIZE = GPUs/node, PIPELINE = #nodes,
#                         include docker-compose.cluster.yml, start workers with
#                         vLLM's run_cluster.sh (see that file's header).
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_PIPELINE_PARALLEL_SIZE=1
VLLM_GPU_COUNT=1

# --- PostgreSQL (one engine, partitioned per app) ----------------------------
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me-superuser
ODYSSEUS_DB_USER=odysseus
ODYSSEUS_DB_PASSWORD=change-me-odysseus
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=change-me-postiz

# --- Odysseus first-run admin ------------------------------------------------
ODYSSEUS_ADMIN_USER=admin
ODYSSEUS_ADMIN_PASSWORD=change-me-admin

# --- Postiz ------------------------------------------------------------------
POSTIZ_JWT_SECRET=change-me-with-openssl-rand-hex-32

# --- SearXNG -----------------------------------------------------------------
# The official image rewrites settings.yml's placeholder with this value.
SEARXNG_SECRET=change-me-with-openssl-rand-hex-32

# --- Tailscale (sole ingress) ------------------------------------------------
# Create a (preferably ephemeral, tagged) auth key in the Tailscale admin panel.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
TS_HOSTNAME=ai-server
# Your tailnet's MagicDNS suffix, e.g. "tailxxxx.ts.net"
TS_TAILNET=your-tailnet.ts.net

# --- Hermes (optional messaging gateway) -------------------------------------
# TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
#  INTEGRATION  (docker-compose.integration.yml) — Meltano + read-only DB MCP
# -----------------------------------------------------------------------------
# Dedicated READ-ONLY Postgres role used by mcp-postgres (apply mcp-readonly.sql):
MCP_RO_DB_USER=mcp_ro
MCP_RO_DB_PASSWORD=change-me-mcp-ro

# Ingestion source credentials (Meltano taps). Set only the sources you ingest.
# GitHub (also used by the GitHub MCP in the repo overlay) — fine-grained read-only PAT:
GITHUB_MCP_PAT=github_pat_xxx
# Jira (also used by the ticketing MCP) — Cloud:
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@corp.com
JIRA_API_TOKEN=ATATT-xxx
# Confluence:
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_API_TOKEN=ATATT-xxx
# Slack (also used by the collab/Slack MCP) — read-only bot token:
SLACK_BOT_TOKEN=xoxb-xxx

# -----------------------------------------------------------------------------
#  REPO  (docker-compose.repo.yml) — GitHub + Bitbucket MCP
#  (GitHub uses GITHUB_MCP_PAT above.) Bitbucket is CLOUD-hosted.
#  Atlassian App Passwords are DEPRECATED (June 2026) -> use a scoped API token.
# -----------------------------------------------------------------------------
BITBUCKET_API_USERNAME=you@corp.com
BITBUCKET_API_TOKEN=ATATT-xxx
BITBUCKET_WORKSPACE=your-workspace

# -----------------------------------------------------------------------------
#  TICKETING  (docker-compose.ticketing.yml) — Jira MCP (read-only)
#  Cloud uses JIRA_BASE_URL/JIRA_EMAIL/JIRA_API_TOKEN above.
#  Server / Data Center instead uses a Personal Access Token:
# -----------------------------------------------------------------------------
# JIRA_PERSONAL_TOKEN=
# Extension slots (only if you enable those services in ticketing.yml):
# LINEAR_API_KEY=
# SERVICENOW_INSTANCE_URL=
# SERVICENOW_TOKEN=

# -----------------------------------------------------------------------------
#  COLLAB  (docker-compose.collab.yml) — Slack MCP
#  SLACK_BOT_TOKEN is set above. SSE guard for the Slack MCP endpoint:
# -----------------------------------------------------------------------------
SLACK_MCP_SSE_API_KEY=change-me-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
#  M365  (docker-compose.m365.yml) — Outlook/Teams/SharePoint + Graph hooks
#  Azure AD app registration with READ-ONLY Graph application permissions,
#  admin-consented.
# -----------------------------------------------------------------------------
MS365_TENANT_ID=
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
# PUBLIC https URL Graph posts notifications to (your Tailscale Funnel hostname):
GRAPH_NOTIFICATION_URL=https://ai-server.your-tailnet.ts.net:10000/graph/notifications
GRAPH_CLIENT_STATE=change-me-with-openssl-rand-hex-32
# JSON list (ONE line). USER_ID/SITE_ID/LIST_ID are real Graph IDs from your tenant:
GRAPH_SUBSCRIPTIONS=[{"resource":"users/USER_ID/messages","changeType":"created,updated"},{"resource":"users/USER_ID/events","changeType":"created,updated"},{"resource":"sites/SITE_ID/lists/LIST_ID","changeType":"updated"}]

# -----------------------------------------------------------------------------
#  ERP — SAP Business One  (docker-compose.erp.yml)  [ON-DEMAND]
#  Use a READ-ONLY SAP user.
# -----------------------------------------------------------------------------
SAP_B1_SERVICE_LAYER_URL=https://sap-host:50000/b1s/v1
SAP_B1_COMPANY_DB=SBODEMOXX
SAP_B1_USER=mcp_readonly
SAP_B1_PASSWORD=change-me
# SL certs are usually self-signed; set true once a proper cert is installed:
SAP_B1_VERIFY_SSL=false
# Shared secret B1if must send in the X-B1-Secret header to the webhook:
SAP_B1_WEBHOOK_SECRET=change-me-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
#  GREENLIGHT GURU  (docker-compose.glg.yml)  [ON-DEMAND]
#  Read-only API key. Confirm base URL / paths / auth from your GLG API reference.
# -----------------------------------------------------------------------------
GLG_API_BASE_URL=https://api.greenlight.guru/v1
GLG_API_KEY=change-me
GLG_AUTH_HEADER=Authorization
GLG_AUTH_PREFIX=Bearer 
GLG_ALLOWED_PATHS=documents,capas,change-orders,complaints,design-controls,risks
GLG_MODIFIED_PARAM=updatedAfter

# -----------------------------------------------------------------------------
#  MONITORING  (docker-compose.monitoring.yml) — Beszel dashboard + Dozzle logs
#  On first run, open the Beszel UI (http://127.0.0.1:8090), create the admin,
#  "Add system" (host: beszel-agent:45876) and paste the shown public key here:
# -----------------------------------------------------------------------------
BESZEL_KEY=

# -----------------------------------------------------------------------------
#  BACKUP — Restic + AWS S3  (scripts/backup.sh; sourced, not used by compose)
#  Bucket should have versioning + Object Lock for immutability.
# -----------------------------------------------------------------------------
RESTIC_REPOSITORY=s3:s3.amazonaws.com/your-immutable-backup-bucket/ai-stack
RESTIC_PASSWORD=change-me-restic-repo-password
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=change-me-aws-secret
AWS_DEFAULT_REGION=us-east-1
